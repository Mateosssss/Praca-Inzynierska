<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Evacuation.Mobile.Views.FloorsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Evacuation.Mobile.Models"
             xmlns:vm="clr-namespace:Evacuation.Mobile.ViewModels"
             x:DataType="vm:FloorsViewModel"
             Style="{StaticResource EvPage}">

    <Grid Padding="20,24" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Button Grid.Row="0"
                Command="{Binding GoBackCommand}"
                HeightRequest="34"
                HorizontalOptions="Start"
                Padding="0"
                Style="{StaticResource EvGhostButton}"
                BorderWidth="0"
                Text="← Budynki" />

        <VerticalStackLayout Grid.Row="1" Margin="0,10,0,0" Spacing="2">
            <Label Style="{StaticResource EvTitle}" Text="Wybierz piętro" />
            <Label Style="{StaticResource EvBody}" Text="{Binding BuildingName}" />
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="2"
                           Margin="0,20"
                           Color="{StaticResource EvAccent}"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}" />

        <CollectionView Grid.Row="3"
                        Margin="0,18,0,0"
                        ItemsSource="{Binding Floors}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FloorSummary">
                    <Border Opacity="{Binding HasPlan, Converter={StaticResource BoolToOpacity}}" Style="{StaticResource EvCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FloorsViewModel}}, Path=SelectFloorCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Style="{StaticResource EvHeading}"
                                   Text="{Binding Label}" />

                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,3,0,0"
                                   Style="{StaticResource EvBody}"
                                   Text="{Binding Detail}" />

                            <Label Grid.Row="0"
                                   Grid.RowSpan="2"
                                   Grid.Column="1"
                                   FontSize="18"
                                   IsVisible="{Binding HasPlan}"
                                   Text="›"
                                   TextColor="{StaticResource EvTextMuted}"
                                   VerticalOptions="Center" />

                            <Border Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,10,0,0"
                                    BackgroundColor="{StaticResource EvDangerDeep}"
                                    HorizontalOptions="Start"
                                    IsVisible="{Binding HasDangerZone}"
                                    Padding="10,5"
                                    Stroke="Transparent">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Label FontSize="11"
                                       Text="{Binding DangerLabel}"
                                       TextColor="{StaticResource EvTextPrimary}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="4"
               Margin="0,16,0,0"
               Style="{StaticResource EvMuted}"
               Text="{Binding Note}" />

    </Grid>

</ContentPage>

<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Evacuation.Mobile.Views.RoutePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Evacuation.Mobile.Views"
             xmlns:vm="clr-namespace:Evacuation.Mobile.ViewModels"
             x:DataType="vm:RouteViewModel"
             Style="{StaticResource EvPage}">

    <Grid Padding="20,24" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="12">

        <Button Grid.Row="0"
                BorderWidth="0"
                Command="{Binding GoBackCommand}"
                HeightRequest="34"
                HorizontalOptions="Start"
                Padding="0"
                Style="{StaticResource EvGhostButton}"
                Text="← Pokój startowy" />

        <VerticalStackLayout Grid.Row="1" Spacing="2">
            <Label Style="{StaticResource EvTitle}" Text="{Binding Title}" />
            <Label Style="{StaticResource EvBody}" Text="{Binding Subtitle}" />
        </VerticalStackLayout>

        <!--  Rzut z naniesioną trasą. Przesuwanie palcem, przybliżanie szczypaniem.  -->
        <Border Grid.Row="2"
                MinimumHeightRequest="260"
                Padding="0"
                Style="{StaticResource EvCard}">
            <Grid>
                <views:PlanMapView CurrentStepIndex="{Binding CurrentStepIndex}"
                                   IsVisible="{Binding HasPlanImage}"
                                   PlanImageUrl="{Binding PlanImageUrl}"
                                   Steps="{Binding Steps}" />

                <Label HorizontalOptions="Center"
                       IsVisible="{Binding HasPlanImage, Converter={StaticResource Not}}"
                       Margin="20"
                       Style="{StaticResource EvMuted}"
                       Text="Podgląd rzutu wymaga połączenia z backendem."
                       VerticalOptions="Center" />

                <ActivityIndicator Color="{StaticResource EvAccent}"
                                   HorizontalOptions="Center"
                                   IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   VerticalOptions="Center" />
            </Grid>
        </Border>

        <!--  Krokowanie po trasie  -->
        <Border Grid.Row="3" IsVisible="{Binding HasRoute}" Style="{StaticResource EvCard}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Style="{StaticResource EvCaps}"
                       Text="{Binding StepCounter}" />

                <Button Grid.Row="1"
                        Grid.Column="0"
                        Command="{Binding PreviousStepCommand}"
                        HeightRequest="42"
                        Style="{StaticResource EvGhostButton}"
                        Text="‹"
                        WidthRequest="52" />

                <Label Grid.Row="1"
                       Grid.Column="1"
                       Margin="0,8,0,0"
                       Style="{StaticResource EvBody}"
                       Text="{Binding CurrentInstruction}"
                       VerticalOptions="Center" />

                <Button Grid.Row="1"
                        Grid.Column="2"
                        Command="{Binding NextStepCommand}"
                        HeightRequest="42"
                        Style="{StaticResource EvGhostButton}"
                        Text="›"
                        WidthRequest="52" />
            </Grid>
        </Border>

        <Border Grid.Row="4" IsVisible="{Binding HasRoute}" Style="{StaticResource EvCard}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Style="{StaticResource EvCaps}"
                       Text="{Binding Route.Headline}" />
                <Label Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,4,0,0"
                       Style="{StaticResource EvBody}"
                       Text="{Binding Route.Summary}" />
                <Label Grid.Row="0"
                       Grid.RowSpan="2"
                       Grid.Column="1"
                       FontAttributes="Bold"
                       FontSize="26"
                       Text="{Binding Route.TotalMetersLabel}"
                       TextColor="{StaticResource EvAccent}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <Button Grid.Row="5"
                Command="{Binding ReportDangerCommand}"
                Style="{StaticResource EvDangerButton}"
                Text="Zgłoś zagrożenie" />

    </Grid>

</ContentPage>

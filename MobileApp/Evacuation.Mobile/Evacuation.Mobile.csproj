<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
			net10.0-android — cel pracy, jedyna platforma faktycznie uruchamiana.
			Workload maui-android 10.0.20 obsługuje wyłącznie API 36.0 i 36.1, więc platformy
			Android SDK poniżej 36 nie wchodzą w grę. Jeśli brakuje android-36, doinstaluj:
			dotnet build -t:InstallAndroidDependencies -f net10.0-android

			net10.0-ios — CELOWO tylko kontrola kompilacji, aplikacja nie jest na iOS uruchamiana.
			Na Windowsie `dotnet build -f net10.0-ios` przechodzi i wyłapuje błędy specyficzne dla
			platformy, ale nie powstaje bundle .app: linkowanie natywne, AOT, pakowanie i podpisywanie
			wymagają macOS z Xcode. Nie usuwaj tego TFM-u w nadziei, że apka ruszy na iPhonie —
			bez Maca się nie uda.
		-->
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<!-- Odkomentuj, aby uruchamiać na Windows — szybsza pętla dev niż emulator Androida.
		     Wymaga workloadu maui-windows.
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		-->

		<OutputType>Exe</OutputType>
		<RootNamespace>Evacuation.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>Ewakuacja</ApplicationTitle>
		<ApplicationId>pl.umk.fizyka.evacuation</ApplicationId>

		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#201F1D" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#201F1D" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

</Project>
